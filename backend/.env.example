# Local development settings; actual credentials belong only in ignored backend/.env.
# Copy to backend/.env when configuring locally. Never commit the copied file.
# Foundation (Phase 2)
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Phase 4: limits may be reduced, not raised above these tested ceilings.
ANALYSIS_MAX_CHARACTERS=20000
ANALYSIS_MAX_TOKENS=4096

# Gemini transformations: backend-only. Missing key leaves detectors usable.
GEMINI_API_KEY=
# Optional signed robustness saving; configure only after migration review.
ROBUSTNESS_SIGNING_KEY=
ROBUSTNESS_SIGNING_KEY_ID=v1
# Optional local test diagnostics only; requires development mode and backend restart.
# No effect without the explicit loopback runner request header; never enable for deployment.
DATABASE_DIAGNOSTICS_ENABLED=false
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MIN_INTERVAL_SECONDS=5

# Hosted Supabase (Phase 3): public project URL + publishable key.
# User access tokens and RLS will enforce ownership; no service-role secret needed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
